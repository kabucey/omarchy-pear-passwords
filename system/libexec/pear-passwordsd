#!/bin/sh
# Pear Passwords 2: start pear-passwordsd from the root-owned venv.
#
# The venv is built for one Python minor version. After a system Python upgrade its
# site-packages no longer match, so refuse with exit 78 (EX_CONFIG), which the window turns
# into "Python was upgraded; re-run the system step" rather than a crash loop.
set -eu

P=/usr/local/lib/pear-passwords
ABI_MISMATCH_EXIT=78

v=$(/usr/bin/python3 -I -c 'import sys; print("%d.%d" % sys.version_info[:2])') || {
    echo "pear-passwordsd: /usr/bin/python3 does not run; re-run the Pear Passwords system step" >&2
    exit "$ABI_MISMATCH_EXIT"
}
if [ ! -d "$P/venv/lib/python$v" ]; then
    echo "pear-passwordsd: Python is now $v but the venv was built for another version;" >&2
    echo "pear-passwordsd: re-run the Pear Passwords system step to rebuild it" >&2
    exit "$ABI_MISMATCH_EXIT"
fi
exec "$P/venv/bin/python" -I -m icp.daemon
