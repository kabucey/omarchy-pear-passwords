# Pear Passwords 2: the daemon's client socket.
#
# Only processes whose effective gid is pear-client can connect, and the group has no members:
# the set-gid pear-exec is the only way to get that gid. The daemon checks the peer again on
# every connection (SO_PEERCRED, SO_PEERPIDFD, /proc).

[Unit]
Description=Pear Passwords key holder socket
Documentation=https://github.com/dragosol/omarchy-pear-passwords/blob/main/docs/protocol.md

[Socket]
ListenStream=/run/pear-passwords/client.sock
SocketUser=pear-passwords
SocketGroup=pear-client
SocketMode=0660
DirectoryMode=0755
Accept=no
# Remove the socket file when the unit stops, so an uninstall leaves nothing owned by
# pear-passwords:pear-client in /run.
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
