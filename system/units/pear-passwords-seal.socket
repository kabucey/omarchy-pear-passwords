# Pear Passwords 2, gate G1 fallback: root's key sealing for pear-passwordsd.
#
# Installed always, enabled only when the shipped pear-passwordsd.service selects
# PEAR_SEAL_BACKEND=seal-service (install-root.sh decides). Group pear-passwords may connect;
# the service itself then serves only the daemon's uid. One connection, one request.

[Unit]
Description=Pear Passwords key sealing (fallback)
Documentation=https://github.com/dragosol/omarchy-pear-passwords/blob/main/docs/security.md

[Socket]
ListenStream=/run/pear-passwords-seal/seal.sock
SocketUser=root
SocketGroup=pear-passwords
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=8
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
