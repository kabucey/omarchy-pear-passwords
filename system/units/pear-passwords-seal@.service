# Pear Passwords 2, gate G1 fallback: one system-scope systemd-creds encrypt or decrypt for
# pear-passwordsd, then exit (icp.vstore.seal_service). Started per connection by
# pear-passwords-seal.socket; holds nothing between requests and logs no payload.
#
# It runs as root because system-scope credentials are root's: it reads the host key
# (/var/lib/systemd/credential.secret, root 0400) and, once PTT is on, the TPM.

[Unit]
Description=Pear Passwords key sealing for pear-passwordsd
Documentation=https://github.com/dragosol/omarchy-pear-passwords/blob/main/docs/security.md

[Service]
ExecStart=/usr/local/lib/pear-passwords/venv/bin/python -I -m icp.vstore.seal_service
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
RuntimeMaxSec=90

# Privileges: root for file ownership only, no capabilities beyond reading its own files.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem and devices: read-only everything; the TPM resource manager is the one device.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
PrivateIPC=yes
ProtectProc=invisible
ProcSubset=pid

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private

RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

LimitCORE=0
