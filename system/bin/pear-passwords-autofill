#!/bin/sh
# pear-passwords-autofill: opt in to browser autofill (register / unregister / status).
#
# Installed root-owned as /usr/local/bin/pear-passwords-autofill. Runs as you - no set-gid, no
# daemon connection - and only writes your own browser's native-messaging manifest. See
# docs/autofill-protocol.md.
exec /usr/local/lib/pear-passwords/venv/bin/python -I -m icp.client.autofill_register "$@"
