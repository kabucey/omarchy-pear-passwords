# Pear Passwords 2: every system path and name, for the shell side.
#
# Sourced by system/install-root.sh, system/uninstall-root.sh and the libexec wrappers; read
# by the tests. backend/icp/daemon/paths.py holds the same values for Python and
# backend/tests/test_paths_agree.py fails if they differ. native/pear-exec.c hard-codes them
# and the clients' test checks it against this file.
#
# Format: KEY=VALUE, one per line, literal absolute values only - no quoting, no $expansion,
# no spaces - so C, Python and sh all parse it the same way. $P in the spec is PREFIX.

PREFIX=/usr/local/lib/pear-passwords
VENV=/usr/local/lib/pear-passwords/venv
VENV_PYTHON=/usr/local/lib/pear-passwords/venv/bin/python
APP_DIR=/usr/local/lib/pear-passwords/app
LIBEXEC=/usr/local/lib/pear-passwords/libexec
PEAR_EXEC=/usr/local/lib/pear-passwords/libexec/pear-exec
DAEMON_WRAPPER=/usr/local/lib/pear-passwords/libexec/pear-passwordsd
AUTOFILL_HOST=/usr/local/lib/pear-passwords/libexec/pear-autofill-host
UNINSTALL_ROOT=/usr/local/lib/pear-passwords/libexec/uninstall-root
FONTS_CONF=/usr/local/lib/pear-passwords/etc/fonts.conf
EMPTY_DIR=/usr/local/lib/pear-passwords/empty
AUTOFILL_REGISTER_BIN=/usr/local/bin/pear-passwords-autofill
ABI_MISMATCH_EXIT=78

# pear-exec role targets (argv[0]; the full argv is in paths.py ROLE_TARGETS)
TARGET_UI=/usr/bin/quickshell
TARGET_CLIP_MODULE=icp.client.clip
TARGET_MIGRATE_MODULE=icp.client.migrate
TARGET_AUTOFILL_MODULE=icp.client.autofill

RUNTIME_DIR=/run/pear-passwords
SOCKET_PATH=/run/pear-passwords/client.sock
STATE_DIR=/var/lib/pear-passwords
INSTALL_STATE_DIR=/var/lib/pear-passwords-install
INSTALL_RECEIPT=/var/lib/pear-passwords-install/receipt.sha256
HOST_CREDENTIAL_SECRET=/var/lib/systemd/credential.secret

SERVICE_USER=pear-passwords
SERVICE_GROUP=pear-passwords
CLIENT_GROUP=pear-client
MIN_CLIENT_UID=1000

UNIT_DIR=/etc/systemd/system
SOCKET_UNIT=pear-passwordsd.socket
SERVICE_UNIT=pear-passwordsd.service
# Gate G1 fallback (root seal service), installed always, enabled only when the shipped
# daemon unit selects it with PEAR_SEAL_BACKEND=seal-service.
SEAL_SOCKET_UNIT=pear-passwords-seal.socket
SEAL_SERVICE_UNIT=pear-passwords-seal@.service
SEAL_SOCKET_PATH=/run/pear-passwords-seal/seal.sock
SYSUSERS_CONF=/etc/sysusers.d/pear-passwords.conf
TMPFILES_CONF=/etc/tmpfiles.d/pear-passwords.conf

APP_ID=io.github.dragosol.PearPasswords
DESKTOP_FILE=/usr/local/share/applications/io.github.dragosol.PearPasswords.desktop

POLKIT_ACTION_PREFIX=io.github.dragosol.pearpasswords
ACTION_UNLOCK=io.github.dragosol.pearpasswords.unlock
ACTION_REVEAL=io.github.dragosol.pearpasswords.reveal
ACTION_MANAGE=io.github.dragosol.pearpasswords.manage
ACTION_AUTOFILL=io.github.dragosol.pearpasswords.autofill
ACTION_AUTOFILL_NAMES=io.github.dragosol.pearpasswords.autofill-names
POLICY_FILE=/usr/share/polkit-1/actions/io.github.dragosol.pearpasswords.policy
LEGACY_POLICY_FILE=/usr/share/polkit-1/actions/org.icp.unlock.policy

NATIVE_HOST_NAME=io.github.dragosol.pearpasswords
NATIVE_HOST_MANIFEST=io.github.dragosol.pearpasswords.json
LEGACY_NATIVE_HOST_MANIFEST=org.icp.native.json
