+    /// `url` if it is https on apple.com or a subdomain of it; throws otherwise.
+    static string appleURL(string url) {
+        import std.algorithm.searching : any, countUntil, endsWith, startsWith;
+        import std.exception : enforce;
+        enforce(url.startsWith("https://"), "refusing a provisioning URL that is not https: " ~ url);
+        string rest = url["https://".length .. $];
+        auto end = rest.countUntil!(c => c == '/' || c == '?' || c == '#');
+        string authority = end < 0 ? rest : rest[0 .. end];
+        enforce(!authority.any!(c => c == '@' || c == '\\'), "refusing a provisioning URL with user info: " ~ url);
+        auto colon = authority.countUntil(':');
+        string host = (colon < 0 ? authority : authority[0 .. colon]).toLower();
+        enforce(host == "apple.com" || (host.endsWith(".apple.com") && host.length > ".apple.com".length),
+            "refusing a provisioning URL outside apple.com: " ~ url);
+        return url;
+    }
+
+    /// GET (postBody is null) or POST to Apple through libcurl, which checks the chain against
+    /// Apple Root CA only and checks the host name. Redirects are not followed.
+    private string appleFetch(string url, string postBody = null) {
+        import std.net.curl : HTTP;
+        import std.exception : enforce;
+        auto http = HTTP();
+        http.caInfo = appleRootCA;
+        http.verifyPeer = true;
+        http.verifyHost = true;
+        http.maxRedirects = 0;
+        http.url = appleURL(url);
+        foreach (key, value; headers) {
+            if (key != "Content-Type") {
+                http.addRequestHeader(key, value);
+            }
+        }
+        if (postBody !is null) {
+            http.method = HTTP.Method.post;
+            http.setPostData(postBody, headers["Content-Type"]);
+        }
+        ubyte[] received;
+        http.onReceive = (ubyte[] data) { received ~= data; return data.length; };
+        http.perform();
+        enforce(http.statusLine.code / 100 == 2, format!"Apple answered %d for %s"(http.statusLine.code, url));
+        return cast(string) received;
     }
 
