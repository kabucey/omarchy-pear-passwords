<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Pear Passwords</vendor>
  <vendor_url>https://github.com/dragosol/omarchy-pear-passwords</vendor_url>
  <icon_name>dialog-password</icon_name>

  <!-- What these actions gate: the release of key material by pear-passwordsd, a daemon that
       runs as the pear-passwords system user and is the only process holding any key. The
       daemon itself asks polkit about the process on the other end of its socket (a pidfd
       subject) and acts on the answer; no client ever reports an answer of its own.

       Every action: auth_self for an active local session, refused for any other or inactive
       session, and never retained, so each request is its own dialog. The owner annotation is
       what allows a non-root daemon to ask about another user's process and to pass the
       details shown in the messages. No action runs a program. -->

  <!-- Tier 1: the account list (names, sites, usernames - never a password). Once per
       window, and again after any lock. -->
  <action id="io.github.dragosol.pearpasswords.unlock">
    <description>Unlock Pear Passwords</description>
    <message>Unlock Pear Passwords to show your accounts</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:pear-passwords</annotate>
  </action>

  <!-- Tier 2: one account's password, notes, code and history, for the grant length shown in
       the window. $(account) is the entry's name and username, sanitized by the daemon. -->
  <action id="io.github.dragosol.pearpasswords.reveal">
    <description>Use a saved password</description>
    <message>Use the saved password for $(account)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:pear-passwords</annotate>
  </action>

  <!-- Changes: iCloud sign-in and sign-out, creating and deleting entries, moving a 1.x vault
       in, starting over after a reset TPM, deleting the old copy, and checking clipboard
       history for saved passwords. -->
  <action id="io.github.dragosol.pearpasswords.manage">
    <description>Change Pear Passwords</description>
    <message>Change Pear Passwords on this computer</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:pear-passwords</annotate>
  </action>

  <!-- Browser autofill: one password for one site, every time, and only while Pear is unlocked
       (the window, or this browser's own unlock below). $(origin) is the site the browser reported, and the browser then holds that
       password. Nothing asks for this until the user turns autofill on in the window. Any
       program of the user can run the autofill role then, hence the explicit wording. -->
  <action id="io.github.dragosol.pearpasswords.autofill">
    <description>Fill a saved password in the browser</description>
    <message>A browser extension asks to fill the password for $(account) on $(origin)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:pear-passwords</annotate>
  </action>

  <!-- Browser autofill, before any fill: the names and usernames of the accounts saved for one
       site, until Pear locks, so the browser's picker can say which account is which. With the
       window closed or locked, approving it also unlocks Pear for that browser connection, for
       2 minutes after its last request. No password is released; every fill still asks with
       the action above. -->
  <action id="io.github.dragosol.pearpasswords.autofill-names">
    <description>Show a browser extension which accounts you have for a site</description>
    <message>A browser extension asks to see which accounts you have saved for $(origin)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:pear-passwords</annotate>
  </action>
</policyconfig>
